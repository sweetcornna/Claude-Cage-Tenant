<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform checks for the parts of Cage Tenant that do not need
       Windows: address validation, the store, and the navigation policy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>CageTenant.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PortalAddress.cs" />
    <Compile Include="../PortalStore.cs" />
    <Compile Include="../WebPolicy.cs" />
    <Compile Include="../LocalInstaller.cs" />
  </ItemGroup>
</Project>
